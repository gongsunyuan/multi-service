                                                                 dim=0))
            new_log_probs.append(dist.log_prob(actions[i]))
            dist_entropies.append(dist.entropy())

        return torch.stack(new_log_probs), state_values, torch.stack(
            dist_entropies)

    def update(self, memory):
        (states_batch, actions, old_log_probs, values, rewards, is_terminals,
         fingerprints, curr_idxs, target_idxs) = memory.get_all()

        advantages = compute_advantages(rewards, values,
                                        is_terminals).to(self.device)
        advantages = (advantages - advantages.mean()) / (advantages.std() +
                                                         1e-5)

        returns = advantages + values

        for _ in range(self.ppo_epochs):
            new_log_probs, state_values, dist_entropy = self.evaluate_batch(
