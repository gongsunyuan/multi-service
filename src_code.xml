import random
import networkx as nx
import time
import heapq
import os  # 需要引入 os 模块来创建目录
from enum import Enum
from loguru import logger

# === 配置与定义 ===
class FlowType(Enum):
    VOIP = 1
    STREAMING = 2

FLOW_PROFILES = {
    FlowType.VOIP: {
        'type': 'VOIP', 'protocol': 'UDP', 'ditg_preset': 'VoIP -x G.711.2',
