<file path="scripts/train/ppo.py">
import sys
import os
from hydra.utils import instantiate
import torch
import random
import numpy as np
import hydra
from pathlib import Path
from omegaconf import DictConfig, OmegaConf
from loguru import logger

import networkx as nx

# Add src to sys.path
sys.path.append(str(Path(__file__).resolve().parent.parent.parent / "src"))

from multi_service.utils import PPOMemory, BankTrafficManager
from multi_service.env.sdn_wrapper import SdnWrapper
from multi_service.env.network_generator import TopologyGenerator
from multi_service.trainers.ppo_trainer import PPOTrainer


def set_seed(seed):
    """Set random seed for reproducibility."""
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed(seed)
        torch.cuda.manual_seed_all(seed)
        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark = False

    logger.info(f"Set random seed to {seed}")


def set_logger(config: DictConfig):
    from mininet.log import setLogLevel
    setLogLevel('critical')
    logger.configure(handlers=[{
        "sink": config.path.trace_file,
        "level": "TRACE"
    }, {
        "sink": config.path.debug_file,
        "level": "DEBUG"
    }, {
        "sink": sys.stderr,
        "level": "INFO"
    }])


def build_workspace(config: DictConfig):
    for key, val in config.new_dir.items():
        new_dir = Path(val)
        new_dir.mkdir(parents=True, exist_ok=True, mode=0o777)
        logger.debug(f"Created directory {new_dir} with mode 0o777")
        OmegaConf.update(config, f"path.{key}", str(new_dir), force_add=True)

    for key, val in config.new_file.items():
        new_file = Path(val)
        new_file.touch(mode=0o777)
        logger.debug(f"Created file {new_file} with mode 0o777")
        OmegaConf.update(config, f"path.{key}", str(new_file), force_add=True)

def resolve_paths(config: DictConfig):
    """Resolve relative paths in config to absolute paths."""
    original_cwd = hydra.utils.get_original_cwd()

    # Resolve Training Topology Path
    train_topo_path = config.topo.train_topo
    if not os.path.isabs(train_topo_path):
        train_topo_path = os.path.join(original_cwd, train_topo_path)
        logger.info(f"Resolved training topology path to {train_topo_path}")

    # Resolve Validation Topology Path (Optional)
    eval_topo_path = config.topo.eval_topo
    if not os.path.isabs(eval_topo_path):
        eval_topo_path = os.path.join(original_cwd, eval_topo_path)
        logger.info(f"Resolved evaluation topology path to {eval_topo_path}")

    # Resolve Fingerprint Path
    if hasattr(config.path, 'fgpt_path') and not os.path.isabs(config.path.fgpt_path):
        abs_fgpt_path = os.path.join(original_cwd, config.path.fgpt_path)
        # Update config with absolute path
        OmegaConf.update(config, "path.fgpt_path", abs_fgpt_path, force_add=True)
        logger.info(f"Resolved fingerprint path to {abs_fgpt_path}")

    return train_topo_path, eval_topo_path

def load_and_merge_topologies(topo_path, val_topo_path, config):
    """Load and merge training and validation topologies."""
    logger.info(
        f"Loading training topology from {topo_path} and eval topology from {val_topo_path}"
    )
    topo_gen = TopologyGenerator()

    train_topo = topo_gen.load_topology(topo_path)
    val_topo = topo_gen.load_topology(val_topo_path)

    max_id = max(train_topo.nodes())
    offset = max_id + 1
    val_topo = nx.convert_node_labels_to_integers(val_topo, first_label=offset)

    combined_topo = train_topo
    bg_nodes = list(train_topo.nodes()
                    )  # Only generate background traffic on training nodes

    val_src_nodes = []
    val_dst_nodes = []

    # Merge Topologies
    combined_topo = nx.union(train_topo, val_topo)
    logger.info(
        f"Topologies merged. Total Nodes: {len(combined_topo.nodes())}")

    # Extract Validation Src/Dst from config and apply offset
    val_src_nodes = [node + offset for node in config.topo.eval.src_nodes]
    val_dst_nodes = [node + offset for node in config.topo.eval.dst_nodes]

    OmegaConf.update(config,
                     "topo.eval.val_src_nodes",
                     val_src_nodes,
                     force_add=True)
    OmegaConf.update(config,
                     "topo.eval.val_dst_nodes",
                     val_dst_nodes,
                     force_add=True)
    logger.debug(
        f"Validation Src Nodes: {val_src_nodes}, Dst Nodes: {val_dst_nodes}")

    return combined_topo, bg_nodes

def initialize_components(config, combined_topo, bg_nodes):
    """Initialize environment, agent, and trainer."""
    # Initialize Environment
    logger.info("Initializing SDN Environment...")
    # Pass combined topology and restrict bg traffic to training nodes
    env = SdnWrapper(combined_topo, config, bg_traffic_nodes=bg_nodes)

    # Initialize Trainer
    logger.info("Initializing PPO Trainer...")
    trainer = instantiate(config.trainer, env=env)

    return trainer

@hydra.main(version_base=None, config_path="../../configs/train", config_name="ppo.yaml")
def train(config: DictConfig):
    # 1. Log Configuration
    build_workspace(config)

    # 2. Set Random Seed
    set_seed(config.seed)
    set_logger(config)
    logger.trace(f"{OmegaConf.to_yaml(config)}")
    env = None
    try:
        # 3. Path Resolution
        topo_path, val_topo_path = resolve_paths(config)

        # 4. Load Topology
        combined_topo, bg_nodes = load_and_merge_topologies(
            topo_path, val_topo_path, config)

        # 5. Initialize Components
        trainer = initialize_components(config, combined_topo, bg_nodes)

        # 6. Start Training
        logger.info("Initialization complete. Starting training...")
        trainer.run()

    except Exception as e:
        logger.exception(
            "An error occurred during training initialization or execution")
        raise e
    finally:
        # Ensure environment is closed properly to clean up Mininet
        if env is not None:
            logger.info("Closing environment...")
            trainer.env.close()

if __name__ == "__main__":
    train()
